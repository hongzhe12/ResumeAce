   <string notr="true">/* 整体窗口背景色 */
QWidget {
    background - color: #f0f0f0;
}

/* 标签样式 */
QLabel {
    color: #333333;
    font - size: 12pt;
    padding: 5px;
}

/* 输入框样式 */
QLineEdit {
    background - color: white;
    border: 1px solid #ccc;
    border - radius: 3px;
    padding: 3px;
}



QPushButton:hover {
    background - color: #45a049; /* 鼠标悬停时的颜色 */
}

QPushButton:pressed {
    background - color: #388e3c; /* 按下时的颜色 */
}

/* 进度条样式 */
QProgressBar {
    border: 1px solid #ccc;
    border - radius: 3px;
    background - color: white;
    text - align: center;
}

QProgressBar::chunk {
    background - color: #007bff;
}</string>
