  <property name="styleSheet">
   <string notr="true">/* 全局字体设置 */
* {
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 14px;
    color: #333333;
}

/* 窗口背景 */
QWidget {
    background-color: white;
	border-radius: 10px;
}

/* 按钮样式 */
QPushButton {
    background-color: #4CAF50;
    border: none;
    color: white;
    padding: 10px 20px;
    border-radius: 5px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #45a049;
}

QPushButton:pressed {
    background-color: #3d8b40;
}

/* 标签样式 */
QLabel {
    color: #333333;
    font-size: 14px;
}

/* 文本框样式 */
QLineEdit {
    background-color: white;
    border: 1px solid #cccccc;
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #4CAF50;
}

/* 组合框样式 */
QComboBox {
    background-color: white;
    border: 1px solid #cccccc;
    border-radius: 5px;
    padding: 5px;
    font-size: 14px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #cccccc;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

QComboBox::down-arrow {
    image: url(:/icons/images/向下.svg);
}

/* 复选框样式 */
QCheckBox {
    color: #333333;
    font-size: 14px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #cccccc;
    border-radius: 3px;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: #4CAF50;
    border: 1px solid #4CAF50;
}

/* 单选框样式 */
QRadioButton {
    color: #333333;
    font-size: 14px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #cccccc;
    border-radius: 8px;
    background-color: white;
}

QRadioButton::indicator:checked {
    background-color: #4CAF50;
    border: 1px solid #4CAF50;
}

/* 滚动条样式 */
QScrollBar:vertical {
    background-color: #f0f0f0;
    width: 12px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background-color: #cccccc;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #f0f0f0;
    height: 12px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    background-color: #cccccc;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* 进度条样式 */
QProgressBar {
    background-color: #f0f0f0;
    border: 1px solid #cccccc;
    border-radius: 5px;
    text-align: center;
    color: #333333;
}

QProgressBar::chunk {
    background-color: #4CAF50;
    border-radius: 5px;
}

/* 菜单栏样式 */
QMenuBar {
    background-color: #f0f0f0;
    color: #333333;
}

QMenuBar::item {
    background-color: transparent;
    padding: 5px 10px;
}

QMenuBar::item:selected {
    background-color: #4CAF50;
    color: white;
}

QMenu {
    background-color: #f0f0f0;
    border: 1px solid #cccccc;
    color: #333333;
}

QMenu::item {
    padding: 5px 20px;
}

QMenu::item:selected {
    background-color: #4CAF50;
    color: white;
}

/* 工具栏样式 */
QToolBar {
    background-color: #f0f0f0;
    border: none;
}

QToolButton {
    background-color: transparent;
    border: none;
    padding: 5px;
}

QToolButton:hover {
    background-color: #4CAF50;
    border-radius: 5px;
}

QToolButton:pressed {
    background-color: #3d8b40;
    border-radius: 5px;
}

/* 状态栏样式 */
QStatusBar {
    background-color: #f0f0f0;
    color: #333333;
}


/* 全局设置 QSpinBox 的样式 */
QSpinBox {
    /* 背景颜色 */
    background-color: #f0f0f0;
    /* 文本颜色 */
    color: #333;
    /* 边框样式，2px 宽的圆角边框 */
    border: 2px solid #ccc;
    border-radius: 5px;
    /* 内边距 */
    padding: 5px;
    /* 字体设置 */
    font-size: 14px;
}

/* 鼠标悬停在 QSpinBox 上时的样式 */
QSpinBox:hover {
    /* 边框颜色改变 */
    border-color: #999;
}

/* QSpinBox 获取焦点时的样式 */
QSpinBox:focus {
    /* 边框颜色改变 */
    border-color: #0078d7;
    /* 背景颜色改变 */
    background-color: #fff;
}

/* 设置 QSpinBox 上下箭头按钮的样式 */
QSpinBox::up-button,
QSpinBox::down-button {
    /* 背景颜色 */
    background-color: #e0e0e0;
    /* 宽度 */
    width: 20px;
    /* 边框样式 */
    border: none;
}

/* 鼠标悬停在上下箭头按钮上时的样式 */
QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    /* 背景颜色改变 */
    background-color: #ccc;
}

/* 设置上箭头按钮的样式 */
QSpinBox::up-arrow {
    /* 箭头图片 */
    image:url(:/icons/resources/images/向上.svg);
    /* 箭头大小 */
    width: 10px;
    height: 10px;
}

/* 设置下箭头按钮的样式 */
QSpinBox::down-arrow {
    /* 箭头图片 */
    image: url(:/icons/resources/images/向下.svg);
    /* 箭头大小 */
    width: 10px;
    height: 10px;
}

/* 禁用状态下的 QSpinBox 样式 */
QSpinBox:disabled {
    /* 背景颜色 */
    background-color: #eee;
    /* 文本颜色 */
    color: #999;
    /* 边框颜色 */
    border-color: #ddd;
}
</string>
