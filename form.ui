        <string notr="true">QProgressBar {
    border: 1px solid grey;
    border-radius: 5px;
	background-color: rgb(243, 243, 243);
    text-align: center;
}

QProgressBar::chunk {
    background-color: #007BFF;
    width: 20px;
    margin: 0.5px;
}</string>
