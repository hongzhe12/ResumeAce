  <property name="styleSheet">
   <string notr="true">/* 主窗口样式 */
QWidget {
    background-color: white; /* 主窗口背景颜色 */
    color: #333333; /* 主窗口文字颜色 */
	border-radius: 10px; /* 文本框圆角 */
}

/* 标签样式 */
QLabel {
    font-size: 14px; /* 标签文字大小 */
    padding: 5px; /* 标签内边距 */
}

/* 文本框样式 */
QLineEdit {
    background-color: white; /* 文本框背景颜色 */
    border: 1px solid #cccccc; /* 文本框边框 */
    border-radius: 3px; /* 文本框圆角 */
    padding: 5px; /* 文本框内边距 */
}

QLineEdit:focus {
    border-color: #1296db; /* 文本框获得焦点时边框颜色 */
    outline: none; /* 去除默认的焦点轮廓 */
}
QScrollBar:vertical
{
    width:8px;
    background:rgb(0,0,0,0%);
    margin:0px,0px,0px,0px;
    padding-top:12px;   /*上预留位置*/
    padding-bottom:12px;    /*下预留位置*/
}
 
/*滚动条中滑块的样式*/
QScrollBar::handle:vertical
{
    width:8px;
    background:rgb(0,0,0,25%);
    border-radius:4px;
    min-height:20px;
}
 
/*鼠标触及滑块样式*/
QScrollBar::handle:vertical:hover
{
    width:9px;
    background:rgb(0,0,0,50%);
    border-radius:4px;
    min-height:20;
}
 
/*设置下箭头*/
QScrollBar::add-line:vertical
{
    height:12px;
    width:10px;
    border-image:url(:/KeyManager/images/icon_pull-down.png);
    subcontrol-position:bottom;
}
 
/*设置上箭头*/
QScrollBar::sub-line:vertical
{
    height:12px;
    width:10px;
    border-image:url(:/KeyManager/images/icon_pull-up.png);
    subcontrol-position:top;
}
 
/*设置下箭头:悬浮状态*/
QScrollBar::add-line:vertical:hover
{
    height:12px;
    width:10px;
    border-image:url(:/KeyManager/images/icon_pull-down2.png);
    subcontrol-position:bottom;
}
 
/*设置上箭头：悬浮状态*/
QScrollBar::sub-line:vertical:hover
{
    height:12px;
    width:10px;
    border-image:url(:/KeyManager/images/icon_pull-up2.png);
    subcontrol-position:top;
}
 
/*当滚动条滚动的时候，上面的部分和下面的部分*/
QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical
{
    background:rgb(0,0,0,10%);
    border-radius:4px;
}

QScrollBar:horizontal
{
    height: 8px;  /* 设置滚动条高度 */
    background: rgb(0, 0, 0, 0%);  /* 背景透明 */
    margin: 0px;  /* 外边距 */
    padding-left: 12px;  /* 左预留位置 */
    padding-right: 12px;  /* 右预留位置 */
}

/* 滚动条中滑块的样式 */
QScrollBar::handle:horizontal
{
    height: 8px;  /* 设置滑块高度 */
    background: rgb(0, 0, 0, 25%);  /* 滑块背景颜色及透明度 */
    border-radius: 4px;
    min-width: 20px;  /* 最小宽度 */
}

/* 鼠标触及滑块样式 */
QScrollBar::handle:horizontal:hover
{
    height: 9px;  /* 鼠标悬停时滑块高度变化 */
    background: rgb(0, 0, 0, 50%);
    border-radius: 4px;
    min-width: 20px;
}

/* 设置右箭头 */
QScrollBar::add-line:horizontal
{
    width: 12px;
    height: 10px;
    border-image: url(:/KeyManager/images/icon_pull-right.png);  /* 对应右箭头图片，需确保资源路径正确 */
    subcontrol-position: right;
}

/* 设置左箭头 */
QScrollBar::sub-line:horizontal
{
    width: 12px;
    height: 10px;
    border-image: url(:/KeyManager/images/icon_pull-left.png);  /* 对应左箭头图片 */
    subcontrol-position: left;
}

/* 设置右箭头:悬浮状态 */
QScrollBar::add-line:horizontal:hover
{
    width: 12px;
    height: 10px;
    border-image: url(:/KeyManager/images/icon_pull-right2.png);
    subcontrol-position: right;
}

/* 设置左箭头：悬浮状态 */
QScrollBar::sub-line:horizontal:hover
{
    width: 12px;
    height: 10px;
    border-image: url(:/KeyManager/images/icon_pull-left2.png);
    subcontrol-position: left;
}

/* 当滚动条滚动的时候，左边的部分和右边的部分 */
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal
{
    background: rgb(0, 0, 0, 10%);
    border-radius: 4px;
}</string>
